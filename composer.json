{
  "name": "bugo/iris",
  "description": "Color spaces, any-to-any conversions and serialization for legacy and modern CSS colors",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bugo",
      "email": "bugo@dragomano.ru"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-ctype": "*"
  },
  "require-dev": {
    "carthage-software/mago": "^1.47",
    "pestphp/pest": "^3.8|^4.7",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "Bugo\\Iris\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "fix": "vendor/bin/mago format",
    "format-check": "vendor/bin/mago format --dry-run",
    "lint": "vendor/bin/mago lint",
    "analyze": "vendor/bin/mago analyze",
    "rector": "vendor/bin/rector process --clear-cache",
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "comparisons": "php comparisons.php",
    "test": "vendor/bin/pest --colors=always --display-warnings",
    "test-coverage": "vendor/bin/pest -d memory_limit=512M --colors=always --coverage --min=100",
    "test-coverage-clover": "vendor/bin/pest --colors=always --min=100 --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --colors=always --min=100 --coverage-html coverage",
    "test-mutate": "vendor/bin/pest --colors=always --mutate --clear-cache -d memory_limit=2G --path=src tests"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "carthage-software/mago": true
    }
  }
}
